{
  "name": "timebox",
  "version": "1.0.0",
  "description": "Obsidian plugin that tracks study and work sessions inside your notes, with an optional pomodoro cycle.",
  "main": "main.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node esbuild.config.mjs test && node .test-out/core.test.cjs && node .test-out/plugin.test.cjs",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "timebox",
    "timer",
    "pomodoro",
    "session",
    "time-tracking"
  ],
  "author": "Samed Yolcu",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "obsidian": "^1.13.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diyar4772/obsidian-timebox.git"
  },
  "bugs": {
    "url": "https://github.com/diyar4772/obsidian-timebox/issues"
  },
  "homepage": "https://github.com/diyar4772/obsidian-timebox#readme"
}
